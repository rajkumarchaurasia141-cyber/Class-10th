rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Public Educational Content: Class 10 Syllabus & Chapters
    // Readable by all students; Writes restricted
    match /class_10/{subjectId}/chapters/{chapterId} {
      allow read: if isValidId(subjectId) && isValidId(chapterId);
      allow write: if false; // Managed via admin console or trusted scripts
    }

    // Public Educational Content: Previous Year Questions (2016-2026)
    match /pyqs/{pyqId} {
      allow read: if isValidId(pyqId);
      allow write: if false;
    }

    // Private Student Data: Study Progress and Quiz History
    match /users/{userId}/progress/{progressId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().keys().hasAll(['userId', 'updatedAt'])
                    && incoming().updatedAt is string;
      allow update: if isOwner(userId)
                    && incoming().userId == existing().userId
                    && incoming().updatedAt is string;
      allow delete: if isOwner(userId);
    }

    // Private Student Data: AI Teacher Doubt Chats
    match /users/{userId}/chats/{chatId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().question is string
                    && incoming().question.size() <= 2000
                    && incoming().answer is string;
      allow update: if false; // Chat messages are immutable
      allow delete: if isOwner(userId);
    }
  }
}
